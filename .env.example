# Local development can leave this unset because Vite proxies /api to FastAPI.
# For Vercel, set this to the public backend origin, without /api/v1.
VITE_API_URL=https://api.your-domain.example

# Dev only: override the Vite proxy target (default http://127.0.0.1:8000).
# VITE_PROXY_TARGET=http://127.0.0.1:8010
